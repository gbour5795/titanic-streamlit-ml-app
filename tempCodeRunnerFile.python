import pandas as pd
from sklearn.datasets import fetch_california_housing

# 1. Chargement du dataset immobilier intégré à Scikit-Learn
california = fetch_california_housing(as_frame=True)
df = california.frame

# 2. Affichage des 5 premiers quartiers
print("Aperçu des données :")
print(df.head())

# 3. Informations sur les colonnes
print("\nStructure du dataset :")
print(df.info())